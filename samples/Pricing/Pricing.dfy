module Translated {
  import opened CSharp

  // C# enum Shop.Pricing.CustomerTier
  datatype CustomerTier = Standard | Silver | Gold

  // C# record Shop.Pricing.Money
  datatype Money = Money(Pence: int64) {
    function Add(other: Money): Money
    {
      Money(Pence + other.Pence)
    }

    // C# property IsZero
    function IsZero(): bool
    {
      Pence == 0
    }
  }

  // C# record Shop.Pricing.LineItem
  datatype LineItem = LineItem(Sku: string, Quantity: int32, UnitPrice: Money)

  // C# record Shop.Pricing.Discount
  datatype Discount = PercentOff(Percent: int32) | FixedOff(Amount: Money) | BuyNGetOneFree(Sku: string, N: int32)

  // C# record Shop.Pricing.Order
  datatype Order = Order(Items: seq<LineItem>, Tier: CustomerTier, Voucher: Option<Discount>)

  // C# static class Shop.Pricing.PriceCalculator
  class PriceCalculator {
    static function LineTotal(item: LineItem): int64
    {
      item.Quantity as int64 * item.UnitPrice.Pence
    }

    static function Subtotal(order: Order): int64
    {
      Sum(Select(Select(order.Items, (i: LineItem) => LineTotal(i)), (x: int64) => x as int)) as int64
    }

    static function TierPercent(tier: CustomerTier): int32
    {
      match tier
      case Standard =>
        0
      case Silver =>
        5
      case Gold =>
        10
    }

    static function DiscountAmount(discount: Discount, order: Order): int64
    {
      match discount
      case PercentOff(_) =>
        Div((Subtotal(order) * discount.Percent as int64) as int, 100) as int64
      case FixedOff(_) =>
        discount.Amount.Pence
      case BuyNGetOneFree(_, _) =>
        FreeItems(order, discount.Sku, discount.N)
    }

    static function FreeItems(order: Order, sku: string, n: int32): int64
      requires n > 0
    {
      var matching: seq<LineItem> := Where(order.Items, (i: LineItem) => i.Sku == sku);
      if SeqCount(matching) == 0 then 0
      else var first: LineItem := matching[0];
      Div(first.Quantity as int, (n + 1) as int) as int64 * first.UnitPrice.Pence
    }

    static function Total(order: Order): int64
    {
      var subtotal: int64 := Subtotal(order);
      var tierDiscount: int64 := Div((subtotal * TierPercent(order.Tier) as int64) as int, 100) as int64;
      var voucherDiscount: int64 := if order.Voucher.None? then 0 else DiscountAmount(order.Voucher.value, order);
      var total: int64 := subtotal - tierDiscount - voucherDiscount;
      if total >= 0 then total else 0
    }

    static method CheapestSku(order: Order) returns (result: Option<string>)
    {
      if |order.Items| == 0 {
        return None;
      }
      var best: LineItem := order.Items[0];
      var tmp0 := order.Items;
      for tmp0i := 0 to |tmp0| {
        var item: LineItem := tmp0[tmp0i];
        if item.UnitPrice.Pence < best.UnitPrice.Pence {
          best := item;
        }
      }
      return Some(best.Sku);
    }

    static method AverageQuantity(items: seq<LineItem>) returns (result: Option<int32>)
    {
      if SeqCount(items) == 0 {
        return None;
      }
      var sum: int32 := 0;
      for i: int32 := 0 to SeqCount(items) {
        sum := sum + items[i].Quantity;
      }
      return Some(Div(sum as int, SeqCount(items) as int) as int32);
    }

    static function AllPositive(order: Order): bool
    {
      forall i: LineItem :: i in order.Items ==> i.Quantity > 0 && i.UnitPrice.Pence >= 0
    }

    static function WithTier(order: Order, tier: CustomerTier): Order
    {
      order.(Tier := tier)
    }
  }
}
